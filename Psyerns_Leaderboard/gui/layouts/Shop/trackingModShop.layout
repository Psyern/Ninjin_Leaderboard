FrameWidgetClass TrackingModShopMenu {
 visible 1
 clipchildren 0
 ignorepointer 1
 position 0 0
 size 1 1
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 scriptclass "TrackingModShopController"
 {
  PanelWidgetClass shop_panel {
   visible 1
   ignorepointer 1
   color 0.12 0.12 0.12 0.95
   position 0 0
   size 0.5 0.7
   halign center_ref
   valign center_ref
   hexactpos 0
   vexactpos 0
   hexactsize 0
   vexactsize 0
   priority 1
   style blank
   {
    TextWidgetClass shop_title {
     ignorepointer 1
     position 0.02 0.02
     size 0.96 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "Reward Shop"
     font "gui/fonts/metronbook14"
    }
    TextWidgetClass shop_points {
     ignorepointer 1
     position 0.02 0.09
     size 0.96 0.05
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "PvE: 0 | PvP: 0"
     font "gui/fonts/metronbook14"
    }
    TextListboxWidgetClass shop_item_list {
     position 0.02 0.15
     size 0.96 0.65
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Default
     font "gui/fonts/metronbook14"
    }
    ButtonWidgetClass shop_btn_minus {
     color 0.3 0.3 0.3 1
     position 0.02 0.83
     size 0.06 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "-"
     font "gui/fonts/metronbook14"
    }
    TextWidgetClass shop_amount {
     ignorepointer 1
     position 0.09 0.84
     size 0.08 0.05
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     text "1"
     font "gui/fonts/metronbook14"
    }
    ButtonWidgetClass shop_btn_plus {
     color 0.3 0.3 0.3 1
     position 0.17 0.83
     size 0.06 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "+"
     font "gui/fonts/metronbook14"
    }
    ButtonWidgetClass shop_btn_buy_pve {
     color 0 0.6 0 1
     position 0.3 0.83
     size 0.32 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "Kaufen (PvE)"
     font "gui/fonts/metronbook14"
    }
    ButtonWidgetClass shop_btn_buy_pvp {
     color 0.7 0.2 0.2 1
     position 0.66 0.83
     size 0.32 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "Kaufen (PvP)"
     font "gui/fonts/metronbook14"
    }
    ButtonWidgetClass shop_btn_close {
     color 0.3 0.3 0.3 1
     position 0.66 0.91
     size 0.32 0.06
     hexactpos 0
     vexactpos 0
     hexactsize 0
     vexactsize 0
     style Editor
     text "Schliessen"
     font "gui/fonts/metronbook14"
    }
   }
  }
 }
}
